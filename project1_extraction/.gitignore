# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# PaddleOCR / PaddleX model cache (ASCII path required on Windows)
.paddlex_cache/
logs/
.tmp_probe/
.tmp_migration/

# Generated extraction outputs
output/json/*
output/excel/*
output/markdown/*
output/batches/*
!output/json/.gitkeep
!output/excel/.gitkeep
!output/markdown/.gitkeep
!output/batches/.gitkeep

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Environment / secrets
.env
.env.*
!.env.example

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
Desktop.ini
.DS_Store
